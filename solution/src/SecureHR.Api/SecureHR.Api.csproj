<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SecureHR.Api</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UserSecretsId>securehr-api-lab</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lab 3: 12.0.1 -> 13.0.3. Cierra CVE-2024-21907 sin cambiar una línea de código. -->
